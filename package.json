{
  "name": "hushgate",
  "version": "0.1.0",
  "description": "Local-first PII firewall between your app and a cloud LLM API. Nothing personal leaves the machine.",
  "keywords": [
    "pii",
    "gdpr",
    "llm",
    "proxy",
    "redaction",
    "pseudonymization",
    "privacy",
    "openai",
    "anthropic"
  ],
  "license": "BUSL-1.1",
  "author": "Johan Becker",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hushgate": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
